{
  "name": "wpiplanner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "WPI Planner — course schedule planner for Workday schedule data.",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:full": "pnpm run data:build && vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "pnpm run test:tools && pnpm run test:unit",
    "test:tools": "node --experimental-strip-types --test 'tools/**/tests/**/*.test.ts'",
    "test:unit": "vitest run",
    "data:build": "node --experimental-strip-types tools/schedb-to-json/src/index.ts data/new.schedb static/schedb.json --report data/schedb-report.json",
    "updateData": "node --experimental-strip-types tools/workday-to-schedb/src/index.ts --output static/schedb.json --year-header static/yearHeader.txt --report data/schedb-report.json"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.0",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@types/node": "^22.0.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
