{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "pnpm run build",
  "outputDirectory": "build",
  "installCommand": "pnpm install --frozen-lockfile",
  "trailingSlash": true,
  "functions": {
    "api/catalog.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/catalog/:file",
      "destination": "/api/catalog?file=:file"
    }
  ],
  "headers": [
    {
      "source": "/_app/immutable/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/schedb.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/yearHeader.txt",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
